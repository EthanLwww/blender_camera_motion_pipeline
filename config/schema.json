{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Blender Motion Pipeline batch configuration",
  "description": "Top level configuration consumed by --config of motion_pipeline_cli.py / render_sequences.py and by the add-on export action. Nested sections mirror the Python dataclasses in config/models.py.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output_root": { "type": "string" },
        "mode": { "type": "string", "enum": ["none", "with_character", "both"] },
        "scene_name_mode": { "type": "string", "enum": ["stem", "filename"] },
        "overwrite": { "type": "boolean" },
        "resume": { "type": "boolean" },
        "save_validation_report": { "type": "boolean" },
        "keep_reports": { "type": "boolean" },
        "verbose": { "type": "boolean" },
        "character_asset_root": { "type": "string" },
        "animation_asset_root": { "type": "string" },
        "character_provider": { "type": "string" },
        "path_mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" }
            },
            "required": ["from", "to"]
          }
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "template_source": { "type": "string" },
        "template_data": { "type": "array", "items": { "type": "object" } },
        "template_names": { "type": "array", "items": { "type": "string" } },
        "template_overrides": { "type": "object" },
        "matrix_source": { "type": "string", "enum": ["auto", "file", "input"] },
        "frame_start": { "type": "integer", "minimum": 0 },
        "frame_scale": { "type": "number", "minimum": 0 },
        "interpolation": { "type": "string", "enum": ["LINEAR", "BEZIER", "CONSTANT"] },
        "unit_scale": {
          "type": "object",
          "additionalProperties": false,
          "description": "Timeline settings only: templates are authored in Blender coordinates and used verbatim, so there is no axis/sign/unit mapping any more.",
          "properties": {
            "fps": { "type": "number", "exclusiveMinimum": 0 },
            "rotation_order": { "type": "string", "enum": ["XYZ", "XZY", "YXZ", "YZX", "ZXY", "ZYX"] }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "sample_step": { "type": "integer", "minimum": 1 },
        "extra_sample_frames": { "type": "array", "items": { "type": "integer" } },
        "clearance": { "type": "number", "minimum": 0 },
        "inside_epsilon": { "type": "number", "minimum": 0 },
        "max_position_jump": { "type": "number", "minimum": 0 },
        "max_rotation_jump_deg": { "type": "number", "minimum": 0 },
        "min_clip_start": { "type": "number", "exclusiveMinimum": 0 },
        "max_clip_end": { "type": "number", "exclusiveMinimum": 0 },
        "occlusion_ray_count": { "type": "integer", "minimum": 1 },
        "check_character_visibility": { "type": "boolean" },
        "min_character_visible_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "min_character_on_screen_frames": { "type": "number", "minimum": 0, "maximum": 1 },
        "character_probe_points": { "type": "integer", "minimum": 1 },
        "check_character_overlap": { "type": "boolean" }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "min_radius": { "type": "number", "minimum": 0 },
        "max_radius": { "type": "number", "minimum": 0 },
        "candidate_count": { "type": "integer", "minimum": 1 },
        "azimuth_samples": { "type": "integer", "minimum": 1 },
        "elevation_samples": { "type": "integer", "minimum": 1 },
        "shell_only": { "type": "boolean" },
        "max_retries": { "type": "integer", "minimum": 0 },
        "random_seed": { "type": "integer" },
        "allow_rotation_adjust": { "type": "boolean" },
        "max_rotation_adjust_deg": { "type": "number", "minimum": 0 },
        "allow_focal_adjust": { "type": "boolean" },
        "focal_adjust_steps": { "type": "number", "minimum": 0 },
        "max_output_candidates": { "type": "integer", "minimum": 0 },
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "distance": { "type": "number" },
            "clipping": { "type": "number" },
            "character_invisible": { "type": "number" },
            "occlusion": { "type": "number" },
            "rotation_delta": { "type": "number" },
            "focal_delta": { "type": "number" }
          }
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": { "type": "string" },
        "samples": { "type": "integer", "minimum": 1 },
        "resolution_x": { "type": "integer", "minimum": 1 },
        "resolution_y": { "type": "integer", "minimum": 1 },
        "resolution_percentage": { "type": "integer", "minimum": 1, "maximum": 100 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "video_format": { "type": "string", "enum": ["mp4", "mkv", "webm", "avi"] },
        "codec": { "type": "string" },
        "constant_rate_factor": { "type": "string" },
        "input_root": { "type": "string" },
        "output_root": { "type": "string" },
        "recursive": { "type": "boolean" },
        "overwrite": { "type": "boolean" },
        "skip_existing": { "type": "boolean" },
        "dry_run": { "type": "boolean" },
        "workers": { "type": "integer", "minimum": 1 },
        "trajectory_mode": { "type": "string", "enum": ["all_frames", "sampled"] },
        "trajectory_step": { "type": "integer", "minimum": 1 },
        "keep_frames": { "type": "boolean" },
        "scene_filter": { "type": "array", "items": { "type": "string" } },
        "motion_filter": { "type": "array", "items": { "type": "string" } },
        "sequence_filter": { "type": "array", "items": { "type": "string" } },
        "log_level": { "type": "string", "enum": ["DEBUG", "INFO", "WARNING", "ERROR"] }
      }
    },
    "composite": {
      "type": "object",
      "additionalProperties": false,
      "description": "Spatio-temporal compound shots: the video is split into segments and every segment plays one or more atomic camera moves at the same time (only moves that drive different axes).",
      "properties": {
        "enabled": { "type": "boolean" },
        "template_path": { "type": "string", "description": "Atomic motion document; empty means the bundled templates/atomic_motion_templates.json" },
        "max_simultaneous": { "type": "integer", "minimum": 1, "maximum": 5, "description": "How many atomic moves may run at the same moment." },
        "max_segments": { "type": "integer", "minimum": 1, "description": "How many segments a video may have; the 0.5 s minimum segment length caps it." },
        "sequences_per_camera": { "type": "integer", "minimum": 1, "maximum": 500, "description": "How many compound sequences one camera gets; character/animation variants are spread over them instead of multiplying the count." },
        "random": { "type": "boolean", "description": "true: the two counts above are maxima of per-sequence draws; false: they are fixed values." },
        "seed": { "type": "integer" },
        "output_mode": { "type": "string", "enum": ["with_base", "only_compound", "only_base"] },
        "duration_mode": { "type": "string", "enum": ["fixed", "random"] },
        "duration": { "type": "number", "minimum": 0.5, "description": "Video length in seconds when duration_mode is fixed." },
        "duration_min": { "type": "number", "minimum": 0.5 },
        "duration_max": { "type": "number", "minimum": 0.5 }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": { "type": "string" },
        "samples": { "type": "integer", "minimum": 1 },
        "resolution_x": { "type": "integer", "minimum": 1 },
        "resolution_y": { "type": "integer", "minimum": 1 },
        "resolution_percentage": { "type": "integer", "minimum": 1, "maximum": 100 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "video_format": { "type": "string", "enum": ["mp4", "mkv", "webm", "avi"] },
        "codec": { "type": "string" },
        "constant_rate_factor": { "type": "string" },
        "input_root": { "type": "string" },
        "output_root": { "type": "string" },
        "recursive": { "type": "boolean" },
        "overwrite": { "type": "boolean" },
        "skip_existing": { "type": "boolean" },
        "dry_run": { "type": "boolean" },
        "workers": { "type": "integer", "minimum": 1 },
        "trajectory_mode": { "type": "string", "enum": ["all_frames", "sampled"] },
        "trajectory_step": { "type": "integer", "minimum": 1 },
        "keep_frames": { "type": "boolean" },
        "scene_filter": { "type": "array", "items": { "type": "string" } },
        "motion_filter": { "type": "array", "items": { "type": "string" } },
        "sequence_filter": { "type": "array", "items": { "type": "string" } },
        "log_level": { "type": "string", "enum": ["DEBUG", "INFO", "WARNING", "ERROR"] }
      }
    },
    "composite": {
      "type": "object",
      "additionalProperties": false,
      "description": "Compound shots: several base templates played one after another inside one sequence, keeping the same total frame range.",
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "type": "string", "enum": ["full", "partial"] },
        "types_per_sequence": { "type": "integer", "minimum": 2, "maximum": 10 },
        "sequence_count": { "type": "integer", "minimum": 1 },
        "seed": { "type": "integer" },
        "output_mode": { "type": "string", "enum": ["with_base", "only_compound", "only_base"] },
        "max_full_sequences": { "type": "integer", "minimum": 1 },
        "max_partial_sequences": { "type": "integer", "minimum": 1 }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where the camera may travel: one oriented box in world space. A shot whose path leaves the box is re-drawn (segment, whole plan, slower atoms, split) and reported; atomic motions are never bent to fit.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["off", "auto", "object", "numbers"],
          "description": "off disables the feature; auto fits a box to the scene's own objects; object uses one object's box; numbers uses centre/size/rotation."
        },
        "object_name": { "type": "string", "description": "Required for mode=object." },
        "center": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "size": {
          "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 },
          "minItems": 3, "maxItems": 3,
          "description": "Full box size (X, Y, Z) in metres for mode=numbers."
        },
        "rotation": {
          "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3,
          "description": "Box orientation, XYZ degrees."
        },
        "margin_percent": { "type": "number", "minimum": 0, "description": "Extra room kept around what mode=auto detects." },
        "inset": { "type": "number", "minimum": 0, "description": "Shrink the usable box by this many metres." },
        "helper_object": { "type": "string", "description": "Helper box drawn in the editor; it is hidden from renders and ignored by mode=auto." },
        "margin": { "type": "number", "minimum": 0, "description": "Safety room a path must leave to be accepted, in metres." },
        "attempts": {
          "type": "array", "items": { "type": "integer", "minimum": 0 },
          "minItems": 4, "maxItems": 4,
          "description": "Tries per re-draw stage: segment redraws, whole-plan redraws, slower-atom redraws, segment splits."
        },
        "strict": { "type": "boolean", "description": "Do not write a sequence whose camera path still leaves the box." }
      }
    },
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "description": "Focus objects: models placed on the scene's single anchor point, one axis of the output matrix (scene x camera x motion x focus object). An Arc shot orbits the object; every other motion is unchanged and the object is simply in frame.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["off", "models"],
          "description": "off disables the feature completely; models adds one axis per enabled entry of models."
        },
        "models": {
          "type": "array",
          "description": "The .blend models to place, in generation order.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "description": "Stable id used in metadata; derived from the file name when empty. Never appears in an output path." },
              "path": { "type": "string", "description": "Absolute path to the .blend model." },
              "label": { "type": "string", "description": "Human readable name (defaults to the file name)." },
              "object_name": { "type": "string", "description": "Take only this object out of the file; empty takes the whole file." },
              "scale": { "type": "number", "exclusiveMinimum": 0, "description": "Uniform scale applied to the model." },
              "rotation": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3, "description": "Model orientation, XYZ degrees." },
              "enabled": { "type": "boolean", "description": "Disabled entries are ignored (and do not need to exist)." }
            },
            "required": ["path"]
          }
        },
        "anchor_mode": {
          "type": "string",
          "enum": ["auto", "object", "numbers"],
          "description": "auto finds the middle of the open part of the scene; object uses anchor_object; numbers uses anchor_location."
        },
        "anchor_object": { "type": "string", "description": "Name of the empty marking the anchor (mode=object)." },
        "anchor_location": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3, "description": "Anchor point in world metres (mode=numbers)." },
        "anchor_clearance": { "type": "number", "minimum": 0, "description": "Free space mode=auto looks for around the anchor, in metres." },
        "keep_visible": { "type": "boolean", "description": "Check per sequence that the focus object really stayed in frame." },
        "visible_ratio": { "type": "number", "minimum": 0, "maximum": 1, "description": "Share of the frames the object has to be in frame for." },
        "strict": { "type": "boolean", "description": "Do not write a sequence whose focus object ends up out of frame." }
      }
    }
  }
}
